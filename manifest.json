{
  "manifest_version": 3,
  "name": "House Rules for Replit",
  "version": "1.0.0",
  "description": "Displays your personal house rules on any Replit page.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://replit.com/*"],
  "content_scripts": [
    {
      "matches": ["https://replit.com/*"],
      "css": [],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "panel.css"],
      "matches": ["https://replit.com/*"]
    }
  ]
}
